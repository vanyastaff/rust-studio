{
  "description": "Codex lifecycle hooks. Excludes Claude status-line installation and transcript-dependent SubagentStop/auto-capture handlers. Current Codex supplies PLUGIN_ROOT plus Claude-compatible environment aliases, event-scoped context output, and SubagentStart agent_type. Unmatched tool hooks inspect payloads to cover canonical Bash/command and older exec_command/cmd forms. SessionEnd retains its three-second limit. Requires bun and host hook trust; local command-hook delivery is not supported by every cloud orchestration surface. See docs/codex-compat.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/session-start.ts\"",
            "statusMessage": "Rust Code Studio: detecting stack...",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/irreversible-guard.ts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/inject-rules.ts\"",
            "timeout": 12
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/usage-log.ts\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/user-prompt-submit.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/fmt-check.ts\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/stop-guard.ts\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/acceptance-guard.ts\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/pre-compact.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/session-end.ts\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${PLUGIN_ROOT}/hooks/scripts/subagent-start.ts\"",
            "statusMessage": "Rust Code Studio: briefing the sub-agent...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
