# Build / generation helpers (not part of the published plugin)
.build/

# Local caches / safety backups (not part of the published plugin)
.fastembed_cache/
plugins/.rust-studio.backup-pre-memory-unify/

# MCP / tool-local state
.serena/

# claude plugin eval output
plugins/rust-studio/evals/results/

# Rust build artifacts (benchmark fixtures are source-only)
target/
*.rlib

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# secrets (autopilot preflight)
.env
.env.*
!.env.example

# autopilot runtime state (dashboard server port/pid)
.autopilot/serve.pid

# per-agent scratch memory written into the plugin tree during a session —
# agent state, not plugin content; must not ship in the distribution
plugins/rust-studio/.claude/agent-memory/
